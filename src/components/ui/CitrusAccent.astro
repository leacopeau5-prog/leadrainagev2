---
/**
 * Agrume stylisé — motif récurrent de la marque Léa Drainage.
 * Reprend les couleurs et la structure du logo (cercle bordeaux + quartiers dorés).
 * À utiliser comme accent décoratif (always aria-hidden).
 */

interface Props {
  /** Taille en px (carré). */
  size?: number;
  /** Variante de couleur. */
  variant?: 'full' | 'monochrome-bordeaux' | 'monochrome-cream' | 'soft';
  /** Opacité globale (0 → 1). */
  opacity?: number;
  /** Classes Tailwind additionnelles (positionnement). */
  class?: string;
  /** Rotation en degrés (effet décoratif). */
  rotation?: number;
}

const {
  size = 64,
  variant = 'full',
  opacity = 1,
  class: className = '',
  rotation = 0,
} = Astro.props;

// Palettes selon variante
const palette = {
  full:                 { ring: '#771617', flesh: '#FBF7F0', wedge: '#E0AE3D', detail: '#771617' },
  'monochrome-bordeaux':{ ring: '#771617', flesh: 'transparent', wedge: '#771617', detail: '#771617' },
  'monochrome-cream':   { ring: '#FBF7F0', flesh: 'transparent', wedge: '#FBF7F0', detail: '#FBF7F0' },
  soft:                 { ring: '#771617', flesh: '#FBF7F0', wedge: '#EFD078', detail: '#955a6a' },
}[variant];

const transformStyle = rotation ? `transform: rotate(${rotation}deg);` : '';
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 64 64"
  width={size}
  height={size}
  class={className}
  style={`opacity:${opacity}; ${transformStyle}`}
  aria-hidden="true"
  focusable="false"
>
  <!-- Cercle extérieur (peau de l'agrume) -->
  <circle cx="32" cy="32" r="30" fill={palette.flesh} stroke={palette.ring} stroke-width="2.5" />

  <!-- 8 quartiers -->
  <g fill={palette.wedge} stroke={palette.detail} stroke-width="0.6" stroke-linejoin="round" opacity="0.95">
    <path d="M32 32 L32 5 A27 27 0 0 1 51.1 12.9 Z" />
    <path d="M32 32 L51.1 12.9 A27 27 0 0 1 59 32 Z" />
    <path d="M32 32 L59 32 A27 27 0 0 1 51.1 51.1 Z" />
    <path d="M32 32 L51.1 51.1 A27 27 0 0 1 32 59 Z" />
    <path d="M32 32 L32 59 A27 27 0 0 1 12.9 51.1 Z" />
    <path d="M32 32 L12.9 51.1 A27 27 0 0 1 5 32 Z" />
    <path d="M32 32 L5 32 A27 27 0 0 1 12.9 12.9 Z" />
    <path d="M32 32 L12.9 12.9 A27 27 0 0 1 32 5 Z" />
  </g>

  <!-- Petits traits (graines stylisées) -->
  <g stroke={palette.detail} stroke-width="0.8" stroke-linecap="round" opacity="0.6">
    <line x1="32" y1="11" x2="32" y2="16" />
    <line x1="46.8" y1="17.2" x2="43.3" y2="20.7" />
    <line x1="53" y1="32" x2="48" y2="32" />
    <line x1="46.8" y1="46.8" x2="43.3" y2="43.3" />
    <line x1="32" y1="53" x2="32" y2="48" />
    <line x1="17.2" y1="46.8" x2="20.7" y2="43.3" />
    <line x1="11" y1="32" x2="16" y2="32" />
    <line x1="17.2" y1="17.2" x2="20.7" y2="20.7" />
  </g>

  <!-- Centre -->
  <circle cx="32" cy="32" r="2" fill={palette.flesh} stroke={palette.detail} stroke-width="0.8" />
</svg>
