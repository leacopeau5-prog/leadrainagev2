---
import SectionHeading from '@components/ui/SectionHeading.astro';
import Card from '@components/ui/Card.astro';
import CitrusAccent from '@components/ui/CitrusAccent.astro';
import { Icon } from 'astro-icon/components';
import { getCollection } from 'astro:content';

const services = (await getCollection('services', (s) => !s.data.draft))
  .sort((a, b) => a.data.order - b.data.order);
---

<section class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-16 md:py-24">
  <SectionHeading
    eyebrow="Les prestations"
    title="Une séance adaptée à votre besoin"
    subtitle="Quatre formules pour répondre à des objectifs différents. Chaque séance commence par un court échange pour personnaliser le protocole."
  />

  {services.length === 0 ? (
    <div class="rounded-[var(--radius-lg)] border border-dashed border-[color:var(--color-taupe-200)] p-10 text-center text-[color:var(--color-ink-muted)]">
      <Icon name="lucide:sparkles" class="h-8 w-8 mx-auto mb-3 text-[color:var(--color-rose)]" aria-hidden="true" />
      <p class="italic">Les prestations seront listées ici dès que les fiches seront finalisées.</p>
    </div>
  ) : (
    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
      {services.map((service) => (
        <Card href={`/prestations/${service.id}`} class="fade-in h-full flex flex-col relative overflow-hidden">
          <CitrusAccent size={56} variant="soft" opacity={0.18} rotation={18} class="absolute -top-3 -right-3 pointer-events-none" />
          <div class="relative inline-flex items-center justify-center h-12 w-12 rounded-full bg-[color:var(--color-accent-100)] text-[color:var(--color-primary)] mb-4">
            <Icon name={service.data.icon} class="h-6 w-6" aria-hidden="true" />
          </div>
          <h3 class="relative text-xl m-0">{service.data.title}</h3>
          <p class="relative mt-3 text-sm text-[color:var(--color-ink-muted)] flex-1">{service.data.summary}</p>
          <p class="relative mt-4 flex items-center gap-1 text-xs text-[color:var(--color-rose)] font-semibold uppercase tracking-wider">
            Découvrir
            <Icon name="lucide:arrow-right" class="h-4 w-4 transition-transform group-hover:translate-x-1" aria-hidden="true" />
          </p>
        </Card>
      ))}
    </div>
  )}
</section>
