---
import SectionHeading from '@components/ui/SectionHeading.astro';
import Card from '@components/ui/Card.astro';
import CitrusAccent from '@components/ui/CitrusAccent.astro';
import { Icon } from 'astro-icon/components';

// Vrais avis Google — mis à jour manuellement depuis la fiche GMB (texte verbatim).
// Seuls les avis avec texte sont affichés ; les avis "étoiles seules" comptent dans reviewCount.
const reviewsUrl =
  'https://www.google.com/search?sca_esv=754e958c4027edbc&q=lea+drainage&sa=X&ved=2ahUKEwicyJuYkfWVAxXqVKQEHd9mFy4Q3PALegQILxAF';

const rating = 4.9;
const reviewCount = 16;

// Du plus récent au plus ancien (date = mois de visite indiqué par Google)
const testimonials = [
  {
    text: "Un véritable moment de bonheur et de bien-être !\nUn massage drainage lymphatique absolument exceptionnel, réalisé avec beaucoup de douceur, de professionnalisme et de savoir-faire. On se sent immédiatement entre de bonnes mains. Le résultat est bluffant : une sensation de légèreté, un corps détendu et un véritable bien-être dès la fin de la séance.\nUn pur moment de détente, avec une personne à l'écoute, attentionnée et passionnée par son métier.\nJe recommande les yeux fermés ! Hâte de revenir pour une prochaine séance.",
    author: 'Anne-Laure Domitin',
    date: 'Octobre 2026',
    stars: 5,
  },
  {
    text: "Léa est très souriante et professionnelle. Le soin est très dynamique et m'a procuré un bien-etre et un soulagement surtout au niveau des douleurs dans les jambes, je recommande.",
    author: 'Ninie Marcel',
    date: 'Octobre 2026',
    stars: 4,
  },
  {
    text: "J'ai eu la chance de passer entre les mains de fée de Léa pour un drainage lymphatique ! Après une course de 5 km, j'avais les jambes lourdes et courbaturées.\nUne heure de détente absolue, un vrai moment de bien-être ! Dès le soir, j'ai ressenti une réelle légèreté dans mes jambes. J'ai passé une nuit parfaite et, le lendemain, j'avais l'impression de flotter sur un nuage ! ☁️✨\nLéa est douce, attentionnée et a des mains de fée ! 🧚‍♀️ Une expérience que je compte intégrer à ma routine dès maintenant. Je recommande les yeux fermés ! 🥰",
    author: 'Charlotte Chatel',
    date: 'Octobre 2026',
    stars: 5,
  },
  {
    text: "Accueil au top et le soin m'a fait beaucoup de bien (drainage lymphatique). Merci à Léa pour son professionnalisme 😊😍😘💋🌸",
    author: 'Zoubida Kennar',
    date: 'Août 2026',
    stars: 5,
  },
  {
    text: "Un moment de détente et une sensation de légèreté et d'apaisement. Je recommande !",
    author: 'Laurine Piquet',
    date: 'Août 2026',
    stars: 5,
  },
  {
    text: 'Une très belle découverte, sympathique et passionnée . Je recommande, un vrai moment de détente avec un drainage énergétique. A renouveler, merci Léa.',
    author: 'Christelle Hemard',
    date: 'Août 2026',
    stars: 5,
  },
  {
    text: "Super drainage avec Léa qui est très à l'écoute !! je recommande 🥰",
    author: 'm_noor',
    date: 'Juillet 2026',
    stars: 5,
  },
  {
    text: "Très belle expérience. Léa est à l'écoute, professionnelle et bienveillante. Le soin a été très bénéfique. Je recommande sans hésiter.",
    author: 'Bérénice Carlier',
    date: 'Juillet 2026',
    stars: 5,
  },
  {
    text: 'Première séance de drainage, super contente',
    author: 'Rachel Dhesse',
    date: 'Juin 2026',
    stars: 5,
  },
  {
    text: 'Une séance très agréable avec un accueil chaleureux et soin de qualité. Je reviendrais avec plaisir.',
    author: 'Laura Davide',
    date: 'Juin 2026',
    stars: 5,
  },
  {
    text: "Bonne expérience, mon drainage s'est bien passé avec Lea. Je recommande vivement !",
    author: 'Isia Bocquet',
    date: 'Juin 2026',
    stars: 5,
  },
  {
    text: 'Super expérience pour cette première séance de drainage ! Très professionnelle. Hâte de revenir 😊',
    author: 'Léa Bejaoui',
    date: 'Juin 2026',
    stars: 5,
  },
  {
    text: "J'ai fait mon tout premier drainage lymphatique avec Léa et c'était une super expérience. Très relaxant, je me suis sentie à l'aise du début à la fin. Professionnelle, douce et attentive, je recommande sans hésiter 😊",
    author: 'Sarah Hiblot',
    date: 'Mai 2026',
    stars: 5,
  },
];

// Couleurs pastel pour les avatars (déterministe par nom pour cohérence)
const avatarColors = [
  { bg: '#F4CCCC', fg: '#771617' }, // rose pâle / bordeaux
  { bg: '#F9E8B8', fg: '#77551A' }, // beige / brun
  { bg: '#EDD5DB', fg: '#8A2634' }, // rose poudré
  { bg: '#E8E1D7', fg: '#5A4A3A' }, // taupe
  { bg: '#FDE5CA', fg: '#8A4A15' }, // pêche / caramel
];

function avatarFor(name: string, i: number) {
  const initial = name.trim().charAt(0).toUpperCase();
  const color = avatarColors[i % avatarColors.length]!;
  return { initial, ...color };
}
---

<section class="relative overflow-hidden bg-[color:var(--color-cream)]">
  <!-- Agrumes décoratifs en background -->
  <CitrusAccent size={180} variant="soft" opacity={0.08} rotation={20} class="absolute top-16 -left-10 pointer-events-none hidden md:block" />
  <CitrusAccent size={100} variant="soft" opacity={0.12} rotation={-25} class="absolute bottom-24 right-8 pointer-events-none hidden md:block" />

  <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-16 md:py-24">
    <SectionHeading
      eyebrow="Elles témoignent"
      title="Ce qu'en disent mes clientes"
    />

    <!-- En-tête avec note Google globale -->
    <div class="mb-10 flex flex-col items-center gap-3 fade-in">
      <a
        href={reviewsUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-3 rounded-full bg-white border border-[color:var(--color-taupe-200)] px-5 py-3 shadow-[var(--shadow-soft)] hover:shadow-[var(--shadow-lift)] transition-all no-underline"
        aria-label={`Voir les ${reviewCount} avis Google — note globale ${rating} sur 5`}
      >
        <!-- Logo Google (SVG officiel, couleurs) -->
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
          <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
          <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
          <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/>
          <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
        </svg>

        <span class="font-semibold text-[color:var(--color-primary)]">Avis Google</span>

        <!-- Étoiles -->
        <span class="flex items-center gap-0.5" aria-hidden="true">
          {Array.from({ length: 5 }).map(() => (
            <svg viewBox="0 0 20 20" width="16" height="16" fill="#E0AE3D">
              <path d="M10 15.27l-5.18 3.05 1.64-5.81L2 8.24l6-.52L10 2l2 5.72 6 .52-4.46 4.27 1.64 5.81z"/>
            </svg>
          ))}
        </span>

        <span class="font-semibold text-[color:var(--color-ink)]">
          {rating.toFixed(1).replace('.', ',')} / 5
        </span>

        <span class="text-sm text-[color:var(--color-ink-muted)] hidden sm:inline">
          · {reviewCount} avis
        </span>

        <svg viewBox="0 0 20 20" width="14" height="14" fill="currentColor" class="text-[color:var(--color-ink-muted)]" aria-hidden="true">
          <path d="M11 3a1 1 0 100 2h2.586l-6.293 6.293a1 1 0 101.414 1.414L15 6.414V9a1 1 0 102 0V4a1 1 0 00-1-1h-5z"/>
          <path d="M5 5a2 2 0 00-2 2v8a2 2 0 002 2h8a2 2 0 002-2v-3a1 1 0 10-2 0v3H5V7h3a1 1 0 000-2H5z"/>
        </svg>
      </a>
    </div>

    <!-- Carrousel des avis : scroll-snap natif + flèches + défilement auto (JS minimal ci-dessous) -->
    <div
      class="relative fade-in"
      data-carousel
      role="region"
      aria-roledescription="carrousel"
      aria-label="Avis de mes clientes"
    >
      <div
        data-carousel-track
        tabindex="0"
        class="flex gap-6 overflow-x-auto snap-x snap-mandatory scroll-smooth pt-1 pb-4 -mx-2 px-2 scroll-px-2 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
      >
      {testimonials.map((t, i) => {
        const avatar = avatarFor(t.author, i);
        return (
          <Card
            class="snap-start shrink-0 w-full md:w-[calc(50%-12px)] lg:w-[calc(33.333%-16px)] flex flex-col"
            variant="default"
          >
            <!-- Header avatar + nom + Avis Google -->
            <div class="flex items-center gap-3 mb-4">
              <div
                class="shrink-0 h-11 w-11 rounded-full flex items-center justify-center font-semibold text-base"
                style={`background:${avatar.bg}; color:${avatar.fg};`}
                aria-hidden="true"
              >
                {avatar.initial}
              </div>
              <div class="flex-1 min-w-0">
                <p class="font-semibold text-[color:var(--color-ink)] m-0 truncate">{t.author}</p>
                <p class="text-xs text-[color:var(--color-ink-muted)] m-0 flex items-center gap-1">
                  Avis de
                  <span class="inline-flex items-center gap-0.5 font-medium">
                    <svg viewBox="0 0 24 24" width="10" height="10" aria-hidden="true">
                      <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
                      <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
                      <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/>
                      <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
                    </svg>
                    Google
                  </span>
                </p>
              </div>
            </div>

            <!-- Étoiles + date -->
            <div class="flex items-center gap-2 mb-3">
              <span class="flex items-center gap-0.5" aria-label={`${t.stars} étoiles sur 5`}>
                {Array.from({ length: 5 }).map((_, k) => (
                  <svg viewBox="0 0 20 20" width="14" height="14" fill={k < t.stars ? '#E0AE3D' : 'var(--color-taupe-100)'}>
                    <path d="M10 15.27l-5.18 3.05 1.64-5.81L2 8.24l6-.52L10 2l2 5.72 6 .52-4.46 4.27 1.64 5.81z"/>
                  </svg>
                ))}
              </span>
              <span class="text-xs text-[color:var(--color-ink-muted)]">{t.date}</span>
            </div>

            <!-- Texte de l'avis -->
            <blockquote class="text-sm text-[color:var(--color-ink)] leading-relaxed flex-1 m-0 space-y-2">
              {t.text.split('\n').map((para, j, all) => (
                <p class="m-0">{j === 0 && '« '}{para}{j === all.length - 1 && ' »'}</p>
              ))}
            </blockquote>
          </Card>
        );
      })}
      </div>

      <!-- Flèches -->
      <div class="mt-4 flex items-center justify-center gap-3">
        <button
          type="button"
          data-carousel-prev
          aria-label="Avis précédents"
          class="h-11 w-11 inline-flex items-center justify-center rounded-full bg-white border border-[color:var(--color-taupe-200)] text-[color:var(--color-primary)] shadow-[var(--shadow-soft)] hover:border-[color:var(--color-rose)] transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[color:var(--color-accent)]"
        >
          <Icon name="lucide:chevron-left" class="h-5 w-5" aria-hidden="true" />
        </button>
        <button
          type="button"
          data-carousel-next
          aria-label="Avis suivants"
          class="h-11 w-11 inline-flex items-center justify-center rounded-full bg-white border border-[color:var(--color-taupe-200)] text-[color:var(--color-primary)] shadow-[var(--shadow-soft)] hover:border-[color:var(--color-rose)] transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[color:var(--color-accent)]"
        >
          <Icon name="lucide:chevron-right" class="h-5 w-5" aria-hidden="true" />
        </button>
      </div>
    </div>

    <!-- CTA voir tous les avis -->
    <div class="mt-10 text-center">
      <a
        href={reviewsUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 text-sm font-semibold text-[color:var(--color-primary)] hover:text-[color:var(--color-rose)] transition-colors"
      >
        Voir tous les avis Google
        <svg viewBox="0 0 20 20" width="14" height="14" fill="currentColor" aria-hidden="true">
          <path fill-rule="evenodd" d="M10.293 5.293a1 1 0 011.414 0l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414-1.414L12.586 11H5a1 1 0 110-2h7.586l-2.293-2.293a1 1 0 010-1.414z" clip-rule="evenodd"/>
        </svg>
      </a>
    </div>

  </div>
</section>

<script>
  // Carrousel des avis : flèches + défilement auto doux.
  // Pause au survol / focus, arrêt définitif dès que la personne fait défiler elle-même,
  // aucun défilement auto si "réduire les animations" est activé.
  const AUTOPLAY_MS = 5000;
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  document.querySelectorAll<HTMLElement>('[data-carousel]').forEach((root) => {
    const track = root.querySelector<HTMLElement>('[data-carousel-track]');
    const prev = root.querySelector<HTMLButtonElement>('[data-carousel-prev]');
    const next = root.querySelector<HTMLButtonElement>('[data-carousel-next]');
    if (!track) return;

    const step = () => {
      const card = track.firstElementChild as HTMLElement | null;
      const gap = parseFloat(getComputedStyle(track).columnGap) || 0;
      return card ? card.offsetWidth + gap : track.clientWidth;
    };
    const atEnd = () => track.scrollLeft + track.clientWidth >= track.scrollWidth - 4;
    const atStart = () => track.scrollLeft <= 4;

    const goNext = () => (atEnd() ? track.scrollTo({ left: 0 }) : track.scrollBy({ left: step() }));
    const goPrev = () => (atStart() ? track.scrollTo({ left: track.scrollWidth }) : track.scrollBy({ left: -step() }));

    let timer: number | undefined;
    let paused = false;
    let stopped = reduceMotion;
    let visible = false;

    const tick = () => {
      if (!paused && !stopped && visible && !document.hidden) goNext();
    };
    const stop = () => {
      stopped = true;
      window.clearInterval(timer);
    };

    next?.addEventListener('click', () => { stop(); goNext(); });
    prev?.addEventListener('click', () => { stop(); goPrev(); });
    track.addEventListener('pointerdown', stop);
    track.addEventListener('wheel', stop, { passive: true });
    track.addEventListener('keydown', stop);
    root.addEventListener('mouseenter', () => { paused = true; });
    root.addEventListener('mouseleave', () => { paused = false; });
    root.addEventListener('focusin', () => { paused = true; });
    root.addEventListener('focusout', () => { paused = false; });

    new IntersectionObserver(([entry]) => { visible = !!entry?.isIntersecting; }, { threshold: 0.3 }).observe(root);

    if (!stopped) timer = window.setInterval(tick, AUTOPLAY_MS);
  });
</script>
