---
import SectionHeading from '@components/ui/SectionHeading.astro';
import { Icon } from 'astro-icon/components';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', (p) => !p.data.draft))
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
  .slice(0, 6);

const formatDate = (d: Date) =>
  d.toLocaleDateString('fr-FR', { year: 'numeric', month: 'long', day: 'numeric' });

const tickerDuration = posts.length * 4.5;
---

{posts.length > 0 && (
  <section class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-16 md:py-24">
    <SectionHeading
      eyebrow="Le blog"
      title="Envie d'en savoir plus ?"
      subtitle="Conseils, guides et réponses aux questions que vous vous posez sur le drainage lymphatique."
    />

    <div class="mx-auto max-w-2xl">
      <div class="relative rounded-[var(--radius-xl)] bg-white shadow-[var(--shadow-lift)] overflow-hidden">
        <!-- Fondus haut/bas pour l'effet menu déroulant -->
        <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 h-12 bg-gradient-to-b from-white to-transparent z-10"></div>
        <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 bottom-0 h-12 bg-gradient-to-t from-white to-transparent z-10"></div>

        <div class="h-[22rem] overflow-hidden px-2">
          <div class="ticker-track" style={`--ticker-duration: ${tickerDuration}s`}>
            {posts.map((post) => (
              <a
                href={`/blog/${post.id}`}
                class="group flex items-center gap-4 px-4 md:px-6 py-5 border-b border-[color:var(--color-taupe-200)] no-underline"
              >
                <div class="min-w-0 flex-1">
                  <p class="text-[11px] uppercase tracking-wider text-[color:var(--color-rose)] font-semibold m-0">
                    {formatDate(post.data.publishDate)}
                  </p>
                  <p class="mt-1 text-sm md:text-base font-semibold text-[color:var(--color-ink)] truncate m-0">
                    {post.data.title}
                  </p>
                </div>
                <Icon
                  name="lucide:arrow-right"
                  class="h-4 w-4 shrink-0 text-[color:var(--color-primary)] transition-transform group-hover:translate-x-1"
                  aria-hidden="true"
                />
              </a>
            ))}
            {posts.map((post) => (
              <a
                href={`/blog/${post.id}`}
                aria-hidden="true"
                tabindex="-1"
                class="ticker-dup group flex items-center gap-4 px-4 md:px-6 py-5 border-b border-[color:var(--color-taupe-200)] no-underline"
              >
                <div class="min-w-0 flex-1">
                  <p class="text-[11px] uppercase tracking-wider text-[color:var(--color-rose)] font-semibold m-0">
                    {formatDate(post.data.publishDate)}
                  </p>
                  <p class="mt-1 text-sm md:text-base font-semibold text-[color:var(--color-ink)] truncate m-0">
                    {post.data.title}
                  </p>
                </div>
                <Icon
                  name="lucide:arrow-right"
                  class="h-4 w-4 shrink-0 text-[color:var(--color-primary)] transition-transform group-hover:translate-x-1"
                  aria-hidden="true"
                />
              </a>
            ))}
          </div>
        </div>
      </div>
    </div>

    <div class="mt-10 text-center">
      <a
        href="/blog"
        class="inline-flex items-center gap-2 text-sm font-semibold text-[color:var(--color-primary)] hover:text-[color:var(--color-rose)] transition-colors"
      >
        Voir tous les articles
        <Icon name="lucide:arrow-right" class="h-4 w-4" aria-hidden="true" />
      </a>
    </div>
  </section>
)}

<style>
  .ticker-track {
    display: flex;
    flex-direction: column;
    animation: ticker-scroll-up var(--ticker-duration, 27s) linear infinite;
  }

  .ticker-track:hover,
  .ticker-track:focus-within {
    animation-play-state: paused;
  }

  @keyframes ticker-scroll-up {
    to {
      transform: translateY(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ticker-track {
      animation: none;
    }

    .ticker-dup {
      display: none;
    }
  }
</style>
