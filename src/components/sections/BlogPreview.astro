---
import SectionHeading from '@components/ui/SectionHeading.astro';
import Card from '@components/ui/Card.astro';
import { Icon } from 'astro-icon/components';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', (p) => !p.data.draft))
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
  .slice(0, 6);

const formatDate = (d: Date) =>
  d.toLocaleDateString('fr-FR', { year: 'numeric', month: 'long', day: 'numeric' });
---

{posts.length > 0 && (
  <section class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-16 md:py-24">
    <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-4 mb-10 md:mb-14">
      <SectionHeading
        eyebrow="Le blog"
        title="Envie d'en savoir plus ?"
        subtitle="Conseils, guides et réponses aux questions que vous vous posez sur le drainage lymphatique."
        align="left"
      />
      <div class="hidden md:flex items-center gap-2 shrink-0 mb-14">
        <button
          type="button"
          data-blog-prev
          aria-label="Article précédent"
          class="inline-flex items-center justify-center h-10 w-10 rounded-full border border-[color:var(--color-taupe-200)] text-[color:var(--color-primary)] hover:border-[color:var(--color-rose)] hover:text-[color:var(--color-rose)] transition-colors disabled:opacity-30 disabled:pointer-events-none"
        >
          <Icon name="lucide:chevron-left" class="h-5 w-5" aria-hidden="true" />
        </button>
        <button
          type="button"
          data-blog-next
          aria-label="Article suivant"
          class="inline-flex items-center justify-center h-10 w-10 rounded-full border border-[color:var(--color-taupe-200)] text-[color:var(--color-primary)] hover:border-[color:var(--color-rose)] hover:text-[color:var(--color-rose)] transition-colors disabled:opacity-30 disabled:pointer-events-none"
        >
          <Icon name="lucide:chevron-right" class="h-5 w-5" aria-hidden="true" />
        </button>
      </div>
    </div>

    <div
      data-blog-track
      class="flex gap-6 overflow-x-auto scrollbar-hide snap-x snap-mandatory scroll-smooth -mx-4 px-4 sm:-mx-6 sm:px-6 lg:-mx-8 lg:px-8"
    >
      {posts.map((post) => (
        <Card
          href={`/blog/${post.id}`}
          class="fade-in shrink-0 w-[85%] sm:w-[340px] flex flex-col snap-start"
        >
          <p class="text-xs uppercase tracking-wider text-[color:var(--color-rose)] font-semibold">
            {formatDate(post.data.publishDate)}
          </p>
          <h3 class="text-lg mt-2 m-0">{post.data.title}</h3>
          <p class="mt-3 text-sm text-[color:var(--color-ink-muted)] flex-1">{post.data.description}</p>
          <p class="mt-4 inline-flex items-center gap-1 text-xs text-[color:var(--color-primary)] font-semibold uppercase tracking-wider">
            Lire l'article
            <Icon name="lucide:arrow-right" class="h-4 w-4 transition-transform group-hover:translate-x-1" aria-hidden="true" />
          </p>
        </Card>
      ))}
    </div>

    <div class="mt-10 text-center md:text-left">
      <a
        href="/blog"
        class="inline-flex items-center gap-2 text-sm font-semibold text-[color:var(--color-primary)] hover:text-[color:var(--color-rose)] transition-colors"
      >
        Voir tous les articles
        <Icon name="lucide:arrow-right" class="h-4 w-4" aria-hidden="true" />
      </a>
    </div>
  </section>
)}

<script>
  document.querySelectorAll<HTMLElement>('[data-blog-track]').forEach((track) => {
    const wrapper = track.closest('section');
    const prevBtn = wrapper?.querySelector<HTMLButtonElement>('[data-blog-prev]');
    const nextBtn = wrapper?.querySelector<HTMLButtonElement>('[data-blog-next]');
    if (!prevBtn || !nextBtn) return;

    const updateButtons = () => {
      const maxScroll = track.scrollWidth - track.clientWidth - 1;
      prevBtn.disabled = track.scrollLeft <= 0;
      nextBtn.disabled = track.scrollLeft >= maxScroll;
    };

    const scrollByCard = (direction: 1 | -1) => {
      const card = track.querySelector<HTMLElement>(':scope > a, :scope > div');
      const amount = (card?.offsetWidth ?? 320) + 24;
      track.scrollBy({ left: amount * direction, behavior: 'smooth' });
    };

    prevBtn.addEventListener('click', () => scrollByCard(-1));
    nextBtn.addEventListener('click', () => scrollByCard(1));
    track.addEventListener('scroll', updateButtons, { passive: true });
    updateButtons();
  });
</script>
