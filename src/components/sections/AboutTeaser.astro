---
import { Image } from 'astro:assets';
import Button from '@components/ui/Button.astro';
import CitrusAccent from '@components/ui/CitrusAccent.astro';
import { Icon } from 'astro-icon/components';
import portrait from '@assets/photos/lea-portrait.jpg';
---

<section class="relative overflow-hidden bg-[color:var(--color-cream)]">
  <!-- Agrumes décoratifs en background, tailles variées -->
  <CitrusAccent size={220} variant="soft" opacity={0.07} rotation={28} class="absolute -top-12 right-12 pointer-events-none hidden lg:block" />
  <CitrusAccent size={130} variant="soft" opacity={0.10} rotation={-15} class="absolute bottom-20 -right-6 pointer-events-none hidden md:block" />

  <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-16 md:py-24 grid lg:grid-cols-5 gap-12 items-center">
    <!-- Portrait Léa en cabinet (photo en situation) -->
    <div class="lg:col-span-2 fade-in">
      <div class="relative mx-auto max-w-md">
        <!-- halo décoratif derrière -->
        <div aria-hidden="true" class="absolute inset-0 rounded-full bg-gradient-to-br from-[color:var(--color-accent-100)] via-[color:var(--color-rose-100)] to-transparent blur-2xl scale-95"></div>
        <!-- cadre photo en situation -->
        <div class="relative aspect-[3/4] rounded-[var(--radius-xl)] border border-[color:var(--color-taupe-300)]/40 shadow-[var(--shadow-lift)] overflow-hidden">
          <!-- petit accent décoratif (rappel du logo agrumes) -->
          <div aria-hidden="true" class="absolute top-4 right-4 h-3 w-3 rounded-full bg-[color:var(--color-accent)] z-10"></div>
          <div aria-hidden="true" class="absolute top-4 right-9 h-2 w-2 rounded-full bg-[color:var(--color-rose)] z-10"></div>
          <Image
            src={portrait}
            alt="Léa, praticienne en drainage lymphatique, en plein soin dans son cabinet à Reims"
            width={1200}
            height={1600}
            class="w-full h-full object-cover object-center"
            loading="lazy"
          />
        </div>
      </div>
    </div>

    <!-- Texte -->
    <div class="lg:col-span-3 fade-in">
      <p class="text-xs md:text-sm font-semibold uppercase tracking-[0.25em] text-[color:var(--color-rose)] mb-3">
        Qui suis-je
      </p>
      <h2 class="m-0">Léa, votre praticienne en drainage lymphatique</h2>
      <p class="mt-5 text-lg text-[color:var(--color-ink-muted)]">
        Formée aux techniques modernes de drainage lymphatique, j'accompagne chaque personne avec une attention
        particulière à son histoire, son rythme et ses objectifs. Mon cabinet à Bétheny (agglomération de Reims) est un espace doux, propre
        et rassurant, où vous prenez enfin le temps de vous écouter.
      </p>
      <p class="mt-4 text-base text-[color:var(--color-ink-muted)]">
        Ma promesse : une approche à la fois professionnelle et chaleureuse, sans jugement, où chaque séance est
        adaptée à ce que vous vivez aujourd'hui.
      </p>

      <div class="mt-8">
        <Button href="/a-propos" variant="primary">
          En savoir plus sur mon parcours
          <Icon name="lucide:arrow-right" class="h-5 w-5" aria-hidden="true" />
        </Button>
      </div>
    </div>
  </div>
</section>
