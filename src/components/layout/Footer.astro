---
import { Icon } from 'astro-icon/components';
import CitrusAccent from '@components/ui/CitrusAccent.astro';
import { site } from '@utils/site';

const year = new Date().getFullYear();
---

<footer class="relative overflow-hidden mt-24 bg-[color:var(--color-primary)] text-white">
  <!-- Agrume décoratif coin haut-droit (très subtil) -->
  <CitrusAccent
    size={180}
    variant="monochrome-cream"
    opacity={0.06}
    rotation={-12}
    class="absolute -top-6 -right-6 pointer-events-none hidden md:block"
  />

  <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-12 grid gap-10 md:grid-cols-4">
    <!-- Colonne 1 : identité -->
    <div class="md:col-span-1">
      <div class="flex items-center gap-3">
        <CitrusAccent size={32} variant="full" />
        <p class="font-[var(--font-heading)] text-2xl font-semibold m-0">Léa Drainage</p>
      </div>
      <p class="mt-2 text-sm text-white/80">Drainage lymphatique à Reims.</p>
    </div>

    <!-- Colonne 2 : navigation -->
    <nav aria-label="Pied de page — navigation" class="md:col-span-1">
      <h2 class="text-sm uppercase tracking-wider text-[color:var(--color-accent-300)] font-semibold">Navigation</h2>
      <ul class="mt-3 space-y-2 text-sm">
        <li><a href="/" class="text-white/90 hover:text-white">Accueil</a></li>
        <li><a href="/prestations" class="text-white/90 hover:text-white">Prestations</a></li>
        <li><a href="/a-propos" class="text-white/90 hover:text-white">À propos</a></li>
        <li><a href="/blog" class="text-white/90 hover:text-white">Blog</a></li>
        <li><a href="/contact" class="text-white/90 hover:text-white">Contact</a></li>
      </ul>
    </nav>

    <!-- Colonne 3 : contact -->
    <div class="md:col-span-1">
      <h2 class="text-sm uppercase tracking-wider text-[color:var(--color-accent-300)] font-semibold">Contact</h2>
      <address class="mt-3 space-y-2 text-sm not-italic text-white/90">
        {site.contact.address.street && (
          <p>
            <Icon name="lucide:map-pin" class="inline-block h-4 w-4 mr-2" aria-hidden="true" />
            {site.contact.address.street}<br />
            {site.contact.address.postalCode} {site.contact.address.city} {site.contact.address.district}
          </p>
        )}
        {site.contact.phoneDisplay && (
          <p>
            <Icon name="lucide:phone" class="inline-block h-4 w-4 mr-2" aria-hidden="true" />
            <a href={`tel:${site.contact.phone}`} class="text-white/90 hover:text-white no-underline">{site.contact.phoneDisplay}</a>
          </p>
        )}
        {site.contact.email && (
          <p>
            <Icon name="lucide:mail" class="inline-block h-4 w-4 mr-2" aria-hidden="true" />
            <a href={`mailto:${site.contact.email}`} class="text-white/90 hover:text-white no-underline break-all">{site.contact.email}</a>
          </p>
        )}
      </address>
    </div>

    <!-- Colonne 4 : légal -->
    <div class="md:col-span-1">
      <h2 class="text-sm uppercase tracking-wider text-[color:var(--color-accent-300)] font-semibold">Informations</h2>
      <ul class="mt-3 space-y-2 text-sm">
        <li><a href="/mentions-legales" class="text-white/90 hover:text-white">Mentions légales</a></li>
        <li><a href="/politique-confidentialite" class="text-white/90 hover:text-white">Politique de confidentialité</a></li>
      </ul>

      {(site.social.instagram || site.social.facebook) && (
        <div class="mt-6 flex items-center gap-3">
          {site.social.instagram && (
            <a href={site.social.instagram} aria-label="Instagram" class="hover:text-[color:var(--color-accent-300)]" rel="noopener noreferrer" target="_blank">
              <Icon name="lucide:instagram" class="h-5 w-5" />
            </a>
          )}
          {site.social.facebook && (
            <a href={site.social.facebook} aria-label="Facebook" class="hover:text-[color:var(--color-accent-300)]" rel="noopener noreferrer" target="_blank">
              <Icon name="lucide:facebook" class="h-5 w-5" />
            </a>
          )}
        </div>
      )}
    </div>
  </div>

  <div class="border-t border-white/10">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-4 text-xs text-white/70 flex flex-col md:flex-row md:justify-between gap-2">
      <p>© {year} Léa Drainage. Tous droits réservés.</p>
      <p>Site créé avec <span aria-hidden="true">✦</span> Astro · Hébergé par Vercel</p>
    </div>
  </div>
</footer>
