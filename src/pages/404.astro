---
import BaseLayout from '@layouts/BaseLayout.astro';
import Button from '@components/ui/Button.astro';
import { Icon } from 'astro-icon/components';
---

<BaseLayout
  title="Page introuvable"
  description="Cette page n'existe pas ou a été déplacée."
  noindex
>
  <section class="min-h-[60vh] flex items-center justify-center px-4 py-16">
    <div class="text-center max-w-lg">
      <p class="text-xs md:text-sm font-semibold uppercase tracking-[0.25em] text-[color:var(--color-rose)] mb-3">
        Erreur 404
      </p>
      <h1 class="m-0">Cette page n'existe pas</h1>
      <p class="mt-4 text-lg text-[color:var(--color-ink-muted)]">
        La page que vous recherchez a peut-être été déplacée ou n'existe pas.
      </p>
      <div class="mt-8 flex flex-wrap gap-3 justify-center">
        <Button href="/" variant="primary">
          <Icon name="lucide:home" class="h-5 w-5" aria-hidden="true" />
          Retour à l'accueil
        </Button>
        <Button href="/contact" variant="secondary">Me contacter</Button>
      </div>
    </div>
  </section>
</BaseLayout>
