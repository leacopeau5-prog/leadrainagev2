---
import { Image } from 'astro:assets';
import BaseLayout from '@layouts/BaseLayout.astro';
import SectionHeading from '@components/ui/SectionHeading.astro';
import Card from '@components/ui/Card.astro';
import CTASection from '@components/sections/CTASection.astro';
import { Icon } from 'astro-icon/components';
import { breadcrumbSchema } from '@utils/seo';
import { site } from '@utils/site';
import portraitApropos from '@assets/photos/lea-apropos.jpg';

const schema = breadcrumbSchema([
  { name: 'Accueil', url: site.url },
  { name: 'À propos', url: `${site.url}/a-propos` },
]);

const values = [
  { icon: 'lucide:heart-handshake', title: 'Écoute',     text: "Je prends le temps de comprendre votre parcours et vos objectifs à chaque séance." },
  { icon: 'lucide:shield-check',    title: 'Rigueur',    text: "Chaque protocole est pensé selon les bonnes pratiques, dans le respect de vos contre-indications." },
  { icon: 'lucide:leaf',            title: 'Douceur',    text: "Les gestes sont doux, rythmés, jamais douloureux — le drainage est un moment pour vous." },
  { icon: 'lucide:sparkles',        title: 'Sur-mesure', text: "Pas de protocole standard : votre séance est adaptée à ce que votre corps vit aujourd'hui." },
];
---

<BaseLayout
  title="À propos — praticienne en drainage lymphatique à Reims"
  description="Découvrez le parcours et la philosophie de Léa, praticienne en drainage lymphatique manuel à Reims. Formée aux techniques modernes, elle reçoit le week-end à Reims la Neuvillette."
  schema={schema}
>
  <!-- Hero court -->
  <section class="bg-[color:var(--color-cream)] py-16 md:py-20">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 text-center">
      <p class="text-xs md:text-sm font-semibold uppercase tracking-[0.25em] text-[color:var(--color-rose)] mb-3 mx-auto">À propos</p>
      <h1 class="m-0">Bienvenue, je suis Léa</h1>
      <p class="mt-6 text-lg text-[color:var(--color-ink-muted)]">
        Praticienne en drainage lymphatique manuel à Reims, j'accompagne chaque personne dans un cadre doux, discret et professionnel.
      </p>
    </div>
  </section>

  <!-- Parcours (avec photo de Léa au cabinet) -->
  <section class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-16 md:py-20">
    <div class="grid lg:grid-cols-5 gap-10 lg:gap-14 items-center">
      <!-- Photo Léa devant l'affiche du cabinet -->
      <div class="lg:col-span-2 fade-in">
        <div class="relative mx-auto max-w-md">
          <!-- halo décoratif -->
          <div aria-hidden="true" class="absolute inset-0 rounded-full bg-gradient-to-br from-[color:var(--color-accent-100)] via-[color:var(--color-rose-100)] to-transparent blur-2xl scale-95"></div>
          <!-- cadre photo -->
          <div class="relative aspect-[3/4] rounded-[var(--radius-xl)] border border-[color:var(--color-taupe-300)]/40 shadow-[var(--shadow-lift)] overflow-hidden">
            <!-- petits accents décoratifs (rappel du logo) -->
            <div aria-hidden="true" class="absolute top-4 right-4 h-3 w-3 rounded-full bg-[color:var(--color-accent)] z-10"></div>
            <div aria-hidden="true" class="absolute top-4 right-9 h-2 w-2 rounded-full bg-[color:var(--color-rose)] z-10"></div>
            <Image
              src={portraitApropos}
              alt="Léa souriante dans son cabinet de drainage lymphatique à Reims la Neuvillette"
              width={1200}
              height={1600}
              class="w-full h-full object-cover object-center"
              loading="lazy"
            />
          </div>
        </div>
      </div>

      <!-- Texte parcours -->
      <div class="lg:col-span-3 fade-in">
        <SectionHeading
          eyebrow="Mon parcours"
          title="Un choix guidé par l'envie de prendre soin"
          align="left"
        />
        <div class="space-y-4 text-lg text-[color:var(--color-ink)]">
          <p>
            J'ai d'abord grandi dans le monde du <strong>sport</strong>. Pendant des années, je l'ai pratiqué, observé, accompagné —
            et j'ai vu à quel point ce qui compte vraiment, sur la durée, c'est la façon dont on prend soin de son corps entre deux
            efforts : la récupération, l'écoute des signaux, le repos, le bien-être au quotidien.
          </p>
          <p>
            De cette conviction est née une véritable envie : <strong>aider chaque femme à se sentir bien dans son corps</strong>,
            à retrouver de la vivacité, de la légèreté, cette énergie qu'on pense parfois avoir perdue. C'est ce fil rouge qui m'a
            naturellement portée vers le drainage lymphatique manuel — une technique qui m'a parlé immédiatement, par sa douceur,
            sa précision, et sa capacité à faire du bien aussi bien après un effort sportif qu'après une chirurgie, une grossesse
            ou simplement une période de vie chargée.
          </p>
          <p>
            Je me forme en continu auprès de praticiennes et praticiens reconnus pour faire évoluer ma pratique et rester attentive
            aux besoins spécifiques de chacune : récupération sportive après un cycle d'entraînement chargé, accompagnement
            pré et post-partum, suite de chirurgie esthétique, préparation à un événement, cure silhouette, ou simplement moment
            de pause dans un quotidien qui court.
          </p>
          <p>
            Mon cabinet à <strong>Reims la Neuvillette</strong> est un espace pensé pour que vous vous sentiez à l'aise dès votre
            arrivée : propre, lumineux, au calme. Un vrai temps pour vous — celui qu'on repousse trop souvent, et dont on ressort
            avec cette sensation précieuse : celle d'un corps plus léger et d'un esprit apaisé.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Valeurs -->
  <section class="bg-[color:var(--color-cream)] py-16 md:py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <SectionHeading eyebrow="Mes valeurs" title="Ce qui guide ma pratique" />
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {values.map((v) => (
          <Card variant="default" class="fade-in text-center">
            <div class="inline-flex items-center justify-center h-14 w-14 rounded-full bg-[color:var(--color-accent-100)] text-[color:var(--color-primary)] mb-4">
              <Icon name={v.icon} class="h-7 w-7" aria-hidden="true" />
            </div>
            <h3 class="text-lg m-0">{v.title}</h3>
            <p class="mt-3 text-sm text-[color:var(--color-ink-muted)]">{v.text}</p>
          </Card>
        ))}
      </div>
    </div>
  </section>

  <CTASection title="On prend rendez-vous ?" subtitle="Je serai ravie de vous accueillir à Reims pour une première séance." />
</BaseLayout>
