---
import BaseLayout from '@layouts/BaseLayout.astro';
import SectionHeading from '@components/ui/SectionHeading.astro';
import BookingCTA from '@components/ui/BookingCTA.astro';
import { Icon } from 'astro-icon/components';
import { breadcrumbSchema } from '@utils/seo';
import { site } from '@utils/site';

const schema = breadcrumbSchema([
  { name: 'Accueil', url: site.url },
  { name: 'Contact', url: `${site.url}/contact` },
]);

const hours = [
  { day: 'Lundi',    value: site.contact.hours.monday },
  { day: 'Mardi',    value: site.contact.hours.tuesday },
  { day: 'Mercredi', value: site.contact.hours.wednesday },
  { day: 'Jeudi',    value: site.contact.hours.thursday },
  { day: 'Vendredi', value: site.contact.hours.friday },
  { day: 'Samedi',   value: site.contact.hours.saturday },
  { day: 'Dimanche', value: site.contact.hours.sunday },
];
---

<BaseLayout
  title="Contact — Cabinet drainage lymphatique Reims la Neuvillette"
  description="Cabinet Léa Drainage à Reims la Neuvillette (24 rue de Bétheny, 51100). Ouvert samedi et dimanche 10h–18h. Réservation en ligne, téléphone, plan d'accès."
  schema={schema}
>
  <section class="bg-[color:var(--color-cream)] py-16 md:py-20">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 text-center">
      <p class="text-xs md:text-sm font-semibold uppercase tracking-[0.25em] text-[color:var(--color-rose)] mb-3 mx-auto">Contact</p>
      <h1 class="m-0">Cabinet de drainage lymphatique à Reims la Neuvillette</h1>
      <p class="mt-6 text-lg text-[color:var(--color-ink-muted)]">
        Cabinet situé au 24 rue de Bétheny, ouvert <strong>samedi et dimanche de 10h à 18h</strong>.
        Le plus simple pour prendre rendez-vous : la réservation en ligne, c'est instantané.
      </p>
      <div class="mt-8">
        <BookingCTA size="lg" variant="primary" />
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-16 md:py-20">
    <div class="grid lg:grid-cols-2 gap-10">
      <!-- Infos -->
      <div>
        <SectionHeading eyebrow="Mes coordonnées" title="Venir au cabinet" align="left" as="h2" />

        <ul class="space-y-5 text-base">
          <li class="flex items-start gap-4">
            <Icon name="lucide:map-pin" class="h-6 w-6 shrink-0 text-[color:var(--color-rose)] mt-0.5" aria-hidden="true" />
            <div>
              <p class="font-semibold text-[color:var(--color-primary)] m-0">Adresse</p>
              <p class="text-[color:var(--color-ink-muted)] m-0">
                {site.contact.address.street}<br />
                {site.contact.address.postalCode} {site.contact.address.city} {site.contact.address.district}
              </p>
            </div>
          </li>

          {site.contact.phoneDisplay && (
            <li class="flex items-start gap-4">
              <Icon name="lucide:phone" class="h-6 w-6 shrink-0 text-[color:var(--color-rose)] mt-0.5" aria-hidden="true" />
              <div>
                <p class="font-semibold text-[color:var(--color-primary)] m-0">Téléphone</p>
                <a href={`tel:${site.contact.phone}`} class="text-[color:var(--color-ink-muted)] hover:text-[color:var(--color-primary)]">{site.contact.phoneDisplay}</a>
              </div>
            </li>
          )}

          {site.contact.email && (
            <li class="flex items-start gap-4">
              <Icon name="lucide:mail" class="h-6 w-6 shrink-0 text-[color:var(--color-rose)] mt-0.5" aria-hidden="true" />
              <div>
                <p class="font-semibold text-[color:var(--color-primary)] m-0">Email</p>
                <a href={`mailto:${site.contact.email}`} class="text-[color:var(--color-ink-muted)] hover:text-[color:var(--color-primary)]">{site.contact.email}</a>
              </div>
            </li>
          )}

          <li class="flex items-start gap-4">
            <Icon name="lucide:clock" class="h-6 w-6 shrink-0 text-[color:var(--color-rose)] mt-0.5" aria-hidden="true" />
            <div class="w-full">
              <p class="font-semibold text-[color:var(--color-primary)] m-0">Horaires</p>
              <table class="mt-2 text-sm text-[color:var(--color-ink-muted)]">
                <tbody>
                  {hours.map((h) => (
                    <tr>
                      <td class="pr-6 py-0.5 font-medium">{h.day}</td>
                      <td class="py-0.5">{h.value}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </li>
        </ul>
      </div>

      <!-- Carte interactive (OpenStreetMap via Leaflet — RGPD-friendly) -->
      <div>
        <SectionHeading eyebrow="Plan d'accès" title="Trouver le cabinet" align="left" as="h2" />
        <div
          id="map"
          class="aspect-square w-full rounded-[var(--radius-lg)] overflow-hidden border border-[color:var(--color-taupe-200)] bg-[color:var(--color-cream)] z-0"
          data-lat={site.contact.address.latitude}
          data-lon={site.contact.address.longitude}
          data-label={`${site.name} — ${site.contact.address.street}`}
        ></div>
        <p class="mt-3 text-xs text-[color:var(--color-ink-muted)] text-center">
          Données cartographiques © <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener noreferrer" class="underline">OpenStreetMap</a>
        </p>
      </div>
    </div>

    <!-- Quartiers et communes desservis (SEO local) -->
    <div class="mt-16 pt-10 border-t border-[color:var(--color-taupe-100)] text-center">
      <h2 class="text-lg md:text-xl m-0">Le cabinet accueille aussi les habitantes des communes voisines</h2>
      <p class="mt-3 text-sm text-[color:var(--color-ink-muted)] max-w-3xl mx-auto">
        Bien situé au nord de Reims, le cabinet est facilement accessible depuis
        <strong>Bétheny</strong>, <strong>Witry-lès-Reims</strong>, <strong>Cernay-lès-Reims</strong>,
        <strong>Saint-Brice-Courcelles</strong>, <strong>La Neuvillette</strong> et l'ensemble du nord rémois.
        Comptez 5 à 15 minutes en voiture depuis ces secteurs. Stationnement facile à proximité.
      </p>
    </div>
  </section>
</BaseLayout>

<script>
  import L from 'leaflet';
  import 'leaflet/dist/leaflet.css';
  // Astro/Vite ne fournit pas les chemins par défaut de Leaflet → on les injecte manuellement.
  import iconUrl from 'leaflet/dist/images/marker-icon.png';
  import iconRetinaUrl from 'leaflet/dist/images/marker-icon-2x.png';
  import shadowUrl from 'leaflet/dist/images/marker-shadow.png';

  const el = document.getElementById('map');
  if (el) {
    const lat = parseFloat(el.dataset.lat ?? '49.2583');
    const lon = parseFloat(el.dataset.lon ?? '4.0317');
    const label = el.dataset.label ?? 'Léa Drainage';

    const map = L.map(el, { scrollWheelZoom: false }).setView([lat, lon], 15);

    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
      maxZoom: 19,
      attribution: '© OpenStreetMap',
    }).addTo(map);

    const icon = L.icon({
      iconUrl: iconUrl.src ?? iconUrl,
      iconRetinaUrl: iconRetinaUrl.src ?? iconRetinaUrl,
      shadowUrl: shadowUrl.src ?? shadowUrl,
      iconSize: [25, 41],
      iconAnchor: [12, 41],
      popupAnchor: [1, -34],
      shadowSize: [41, 41],
    });

    L.marker([lat, lon], { icon })
      .addTo(map)
      .bindPopup(`<strong>${label}</strong>`)
      .openPopup();
  }
</script>

<style>
  /* Le z-index de Leaflet (panes 200-700) doit rester sous le header sticky (z-40) */
  :global(.leaflet-pane), :global(.leaflet-top), :global(.leaflet-bottom) {
    z-index: 1 !important;
  }
  :global(.leaflet-control) {
    z-index: 2 !important;
  }
  :global(.leaflet-popup-pane) {
    z-index: 3 !important;
  }
</style>
