---
import BaseLayout from '@layouts/BaseLayout.astro';
import SectionHeading from '@components/ui/SectionHeading.astro';
import Card from '@components/ui/Card.astro';
import CitrusAccent from '@components/ui/CitrusAccent.astro';
import CTASection from '@components/sections/CTASection.astro';
import { Icon } from 'astro-icon/components';
import { getCollection } from 'astro:content';
import { breadcrumbSchema } from '@utils/seo';
import { site } from '@utils/site';

const services = (await getCollection('services', (s) => !s.data.draft))
  .sort((a, b) => a.data.order - b.data.order);

const schema = breadcrumbSchema([
  { name: 'Accueil', url: site.url },
  { name: 'Prestations', url: `${site.url}/prestations` },
]);
---

<BaseLayout
  title="Prestations & tarifs drainage lymphatique à Reims"
  description="4 prestations de drainage lymphatique à Reims : bien-être (80€), récupération sportive (80€), post-opératoire (80€) et cure silhouette 5 séances (350€). Réservation en ligne."
  schema={schema}
>
  <section class="relative overflow-hidden bg-[color:var(--color-cream)] py-16 md:py-20">
    <!-- Agrumes décoratifs en background -->
    <CitrusAccent size={180} variant="soft" opacity={0.08} rotation={-20} class="absolute top-8 -left-8 pointer-events-none hidden md:block" />
    <CitrusAccent size={110} variant="soft" opacity={0.12} rotation={25} class="absolute bottom-6 right-12 pointer-events-none hidden md:block" />

    <div class="relative mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 text-center">
      <p class="text-xs md:text-sm font-semibold uppercase tracking-[0.25em] text-[color:var(--color-rose)] mb-3 mx-auto">Prestations & tarifs</p>
      <h1 class="m-0">Drainage lymphatique à Reims : 4 prestations adaptées à chaque besoin</h1>
      <p class="mt-6 text-lg text-[color:var(--color-ink-muted)]">
        Chaque séance débute par un court échange pour adapter le protocole à votre état du jour, votre objectif et d'éventuelles contre-indications.
        Tarifs entre <strong>80 €</strong> et <strong>350 €</strong> (cure 5 séances) — paiement au cabinet.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-16 md:py-24">
    <SectionHeading eyebrow="Choisissez votre séance" title="Les prestations proposées" />

    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
      {services.map((service) => (
        <Card href={`/prestations/${service.id}`} class="fade-in h-full flex flex-col relative overflow-hidden">
          <CitrusAccent size={56} variant="soft" opacity={0.18} rotation={18} class="absolute -top-3 -right-3 pointer-events-none" />
          <div class="relative inline-flex items-center justify-center h-12 w-12 rounded-full bg-[color:var(--color-accent-100)] text-[color:var(--color-primary)] mb-4">
            <Icon name={service.data.icon} class="h-6 w-6" aria-hidden="true" />
          </div>
          <h2 class="relative text-xl m-0">{service.data.title}</h2>
          <p class="relative mt-3 text-sm text-[color:var(--color-ink-muted)] flex-1">{service.data.summary}</p>
          <div class="relative mt-5 pt-5 border-t border-[color:var(--color-taupe-100)] flex items-center justify-between text-xs text-[color:var(--color-ink-muted)]">
            <span class="flex items-center gap-1.5"><Icon name="lucide:clock" class="h-4 w-4" aria-hidden="true" />{service.data.duration}</span>
            <span class="text-[color:var(--color-rose)] font-semibold uppercase tracking-wider inline-flex items-center gap-1">
              Découvrir
              <Icon name="lucide:arrow-right" class="h-4 w-4 transition-transform group-hover:translate-x-1" aria-hidden="true" />
            </span>
          </div>
        </Card>
      ))}
    </div>

    <p class="mt-10 text-sm text-center text-[color:var(--color-ink-muted)]">
      Les tarifs sont indiqués au moment de la réservation sur Cal.com.
    </p>
  </section>

  <CTASection />
</BaseLayout>
