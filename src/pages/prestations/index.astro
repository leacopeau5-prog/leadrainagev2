---
import BaseLayout from '@layouts/BaseLayout.astro';
import SectionHeading from '@components/ui/SectionHeading.astro';
import Card from '@components/ui/Card.astro';
import CTASection from '@components/sections/CTASection.astro';
import { Icon } from 'astro-icon/components';
import { getCollection } from 'astro:content';
import { breadcrumbSchema } from '@utils/seo';
import { site } from '@utils/site';

const services = (await getCollection('services', (s) => !s.data.draft))
  .sort((a, b) => a.data.order - b.data.order);

const schema = breadcrumbSchema([
  { name: 'Accueil', url: site.url },
  { name: 'Prestations', url: `${site.url}/prestations` },
]);
---

<BaseLayout
  title="Prestations"
  description="Découvrez les prestations de drainage lymphatique proposées par Léa à Reims : bien-être, post-opératoire, cure silhouette."
  schema={schema}
>
  <section class="bg-[color:var(--color-cream)] py-16 md:py-20">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 text-center">
      <p class="text-xs md:text-sm font-semibold uppercase tracking-[0.25em] text-[color:var(--color-rose)] mb-3">Prestations</p>
      <h1 class="m-0">Des séances adaptées à chaque besoin</h1>
      <p class="mt-6 text-lg text-[color:var(--color-ink-muted)]">
        Chaque prestation débute par un court échange pour adapter le protocole à votre état du jour et vos objectifs.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-16 md:py-24">
    <SectionHeading eyebrow="Choisissez votre séance" title="Les prestations proposées" />

    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
      {services.map((service) => (
        <Card href={`/prestations/${service.id}`} class="fade-in h-full flex flex-col">
          <div class="inline-flex items-center justify-center h-12 w-12 rounded-full bg-[color:var(--color-accent-100)] text-[color:var(--color-primary)] mb-4">
            <Icon name={service.data.icon} class="h-6 w-6" aria-hidden="true" />
          </div>
          <h2 class="text-xl m-0">{service.data.title}</h2>
          <p class="mt-3 text-sm text-[color:var(--color-ink-muted)] flex-1">{service.data.summary}</p>
          <div class="mt-5 pt-5 border-t border-[color:var(--color-taupe-100)] flex items-center justify-between text-xs text-[color:var(--color-ink-muted)]">
            <span class="flex items-center gap-1.5"><Icon name="lucide:clock" class="h-4 w-4" aria-hidden="true" />{service.data.duration}</span>
            <span class="text-[color:var(--color-rose)] font-semibold uppercase tracking-wider inline-flex items-center gap-1">
              Découvrir
              <Icon name="lucide:arrow-right" class="h-4 w-4 transition-transform group-hover:translate-x-1" aria-hidden="true" />
            </span>
          </div>
        </Card>
      ))}
    </div>

    <p class="mt-10 text-sm text-center text-[color:var(--color-ink-muted)]">
      Les tarifs sont indiqués au moment de la réservation sur Cal.com.
    </p>
  </section>

  <CTASection />
</BaseLayout>
